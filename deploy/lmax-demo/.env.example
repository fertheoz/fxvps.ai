# Copy to .env (chmod 600) on the CT only. Never commit .env.
# Shared secret between core-engine and fix-gateway's admin endpoint (>= 16 chars):
#   openssl rand -hex 24
FIX_ADMIN_TOKEN=
# Image tag: latest (main) or a pinned sha-xxxxxxx.
FIXVPS_TAG=latest
RUST_LOG=info

# --- console.fxvps.ai (Cloudflare Tunnel + Access); leave empty for SSH-tunnel mode ---
# CORE_DEV_AUTH=0
# CF_ACCESS_TEAM=<team>              # <team>.cloudflareaccess.com
# CF_ACCESS_AUD=<application AUD tag>
# CF_ACCESS_ADMINS=you@example.com   # comma-separated, mapped to the admin role
# CLOUDFLARE_TUNNEL_TOKEN=<tunnel token>
