# Copy to .env (chmod 600) on the CT only. Never commit .env.
# Shared secret: in-process LP admin endpoint (>= 16 chars): openssl rand -hex 24
FIX_ADMIN_TOKEN=
# Identity database password: openssl rand -hex 24
PG_PASSWORD=
# Cloudflare tunnel token (Zero Trust -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
FIXVPS_TAG=latest
RUST_LOG=info

# --- Mail (identity: verification / password reset) ---
# Resend: IDENTITY_SMTP_URL=smtps://resend:<API_KEY>@smtp.resend.com:465
# IDENTITY_SMTP_URL=
# IDENTITY_MAIL_FROM=fxvps.ai <noreply@fxvps.ai>
# Fallback without SMTP (links in the log only); ignored once IDENTITY_SMTP_URL is set.
IDENTITY_DEV_MAILER=1
