{
  "uid": "fxvps-overview",
  "title": "fxvps — Genel Bakış",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    { "id": 1, "type": "stat", "title": "Hedef durumu (up)", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}}" }] },
    { "id": 2, "type": "timeseries", "title": "OTel collector alınan metrik noktaları/sn", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[1m]))" }] },
    { "id": 3, "type": "timeseries", "title": "Scrape süresi (sn)", "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "scrape_duration_seconds", "legendFormat": "{{job}}" }] }
  ]
}
